<%# Auto-dismiss flash message controlled by Stimulus %>
<div data-controller="auto-dismiss"
     class="<%= type == 'notice' ? 'bg-green-50 text-green-800 border-green-200' : 'bg-red-50 text-red-800 border-red-200' %> border px-4 py-2 rounded-lg text-sm mb-2 transition-opacity duration-300">
  <%= message %>
</div>
