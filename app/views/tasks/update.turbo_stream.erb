<%# Replace the task card with updated content %>
<%= turbo_stream.replace dom_id(@task) do %>
  <%= render partial: "tasks/task", locals: { task: @task, board: @board } %>
<% end %>

<%= turbo_stream.prepend "flash" do %>
  <%= render partial: "shared/flash", locals: { type: "notice", message: "Task updated!" } %>
<% end %>
